# Stellar Network Configuration
# ==============================

# Your Stellar private key (NEVER commit the actual key)
# Generate at: https://laboratory.stellar.org/#account-creator
STELLAR_PRIVATE_KEY=SA...your_private_key_here

# Your Stellar public key
STELLAR_PUBLIC_KEY=GB...your_public_key_here

# Network selection: "testnet" or "mainnet"
STELLAR_NETWORK=testnet

# Server Configuration
# ====================

# Port for HTTP server
PORT=8080

# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security Settings
# =================

# Enable/disable debug logging (true/false)
DEBUG_MODE=true

# Rate limiting (requests per second)
RATE_LIMIT=10

# Maximum transaction amount (in stroops)
MAX_TRANSACTION_AMOUNT=1000000000

# Stellar Horizon Configuration
# ==============================

# Horizon server URL (leave empty to use default)
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
HORIZON_URL=

# Timeout for Horizon API calls (in seconds)
HORIZON_TIMEOUT=30
